@app.post("/api/admin/payments/<int:request_id>")
@admin_required
def profitzone_admin_review_payment(request_id):
    data = request.get_json(silent=True) or {}
    status = data.get("status")
    if status not in ("approved", "rejected"):
        return jsonify(error="Status must be approved or rejected"), 400
    with get_db() as db:
        cur = db.execute("""
            UPDATE payment_requests SET status = ?
            WHERE id = ? AND status = 'pending'
        """, (status, request_id))
        if cur.rowcount != 1:
            return jsonify(error="Request not found or already reviewed"), 409
        db.commit()
    return jsonify(message="Request status updated", status=status)


